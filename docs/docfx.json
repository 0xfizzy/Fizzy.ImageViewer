{
  "build": {
    "maxParallelism": 1,
    "content": [
      {
        "src": "docs",
        "files": [
          "index.md",
          "toc.yml"
        ],
        "dest": "."
      },
      {
        "src": ".",
        "files": [
          "README*.md",
          "docs/**/*.md",
          "docs/**/toc.yml"
        ],
        "exclude": [
          "docs/nuget-readme.md",
          "docs/index.md",
          "docs/toc.yml"
        ],
        "dest": "."
      },
      {
        "src": "artifacts/docs/api",
        "files": [
          "**/*.yml",
          "index.md"
        ],
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "LICENSE",
          "assets/**",
          "samples/**/*.cs",
          "samples/**/*.csproj",
          "samples/**/*.xaml",
          "docs/site/**"
        ],
        "exclude": [
          "**/bin/**",
          "**/obj/**"
        ],
        "src": ".",
        "dest": "."
      }
    ],
    "dest": "../site",
    "template": [
      "default",
      "modern",
      "docs/template"
    ],
    "globalMetadata": {
      "_appTitle": "Fizzy.ImageViewer",
      "_appLogoPath": "assets/icon.png",
      "_appFaviconPath": "assets/icon.png",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "disableGitFeatures": true
  }
}
