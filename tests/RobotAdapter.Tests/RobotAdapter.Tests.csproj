<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" PrivateAssets="all" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250507" />
    <ProjectReference Include="../../Fizzy.ImageViewer.csproj" />
    <ProjectReference Include="../../../RobotController/src/Robot.Core/Robot.Core.csproj" />
    <!-- Exercise actual adapter sources without loading RobotController's plugin deployment graph. -->
    <Compile Include="../../../RobotController/src/Robot.Visualization.ImageViewer.Robot/FrameSource.cs" Link="Adapters/FrameSource.cs" />
    <Compile Include="../../../RobotController/src/Robot.Visualization.ImageViewer.OpenCvSharp/MatSource.cs" Link="Adapters/MatSource.cs" />
  </ItemGroup>
</Project>
