<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NuGetLockFilePath Condition="'$(CudaMajor)' == '12' or '$(CudaMajor)' == '13'">packages.cuda$(CudaMajor).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PublicApi.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CudaPublicApi.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" PrivateAssets="all" />
    <ProjectReference Include="../../src/Fizzy.ImageViewer/Fizzy.ImageViewer.csproj" />
    <ProjectReference Include="../../src/Fizzy.ImageViewer.Cuda/Fizzy.ImageViewer.Cuda.csproj" />
  </ItemGroup>
</Project>
