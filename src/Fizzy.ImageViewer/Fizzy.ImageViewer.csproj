<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Fizzy.ImageViewer</PackageId>
    <Version>1.2.0</Version>
    <Authors>0xfizzy</Authors>
    <Description>WPF image viewer with zoom, pan, overlays, measurements, shape editing and pixel inspection.</Description>
    <PackageTags>WPF;ImageViewer;Visualization</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/0xfizzy/Fizzy.ImageViewer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0xfizzy/Fizzy.ImageViewer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" Condition="'$(ReleaseReadme)' == ''" />
    <None Include="$(ReleaseReadme)" Pack="true" PackagePath="/README.md" Condition="'$(ReleaseReadme)' != ''" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
