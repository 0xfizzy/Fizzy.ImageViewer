<Window x:Class="EmbeddedViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:Fizzy.ImageViewer;assembly=Fizzy.ImageViewer"
        Title="Embedded ImageViewer" Width="960" Height="680"
        Loaded="OnLoaded" Closing="OnClosing">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Fit image" Click="FitImage" Padding="10,5" Margin="0,0,8,0" />
            <Button Content="Measure length" Click="MeasureLength" Padding="10,5" Margin="0,0,8,0" />
            <Button Content="End interaction" Click="EndInteraction" Padding="10,5" />
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Wheel: zoom. Middle button: pan. Right click: measurements and export." />
        <TabControl>
            <TabItem Header="Image">
                <viewer:ImageViewerControl x:Name="ImageViewer" />
            </TabItem>
            <TabItem Header="Other content">
                <TextBlock Margin="20" TextWrapping="Wrap"
                           Text="Return to Image: the frame and completed measurements are retained. Unloading ends the current interaction." />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
