{
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml", "README*.md", "docs/**/*.md", "docs/**/toc.yml"], "exclude": ["docs/nuget-readme.md"] },
      { "src": "artifacts/docs/api", "files": ["**/*.yml"], "dest": "api" }
    ],
    "resource": [{ "files": ["LICENSE", "assets/**", "samples/**/*.cs", "samples/**/*.csproj", "docs/site/**"], "exclude": ["**/bin/**", "**/obj/**"] }],
    "dest": "artifacts/docs/site",
    "template": ["default", "modern", "docs/template"],
    "globalMetadata": { "_appTitle": "Fizzy.ImageViewer", "_appLogoPath": "assets/icon.png", "_appFaviconPath": "assets/icon.png", "_enableSearch": true, "_disableContribution": true },
    "disableGitFeatures": true
  }
}
